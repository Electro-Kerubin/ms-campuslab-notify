# RabbitMQ connection. Use ADDRESSES for a cluster, for example:
# amqp://user:pass@ec2-mq-1:5672/vhost,amqp://user:pass@ec2-mq-2:5672/vhost
RABBITMQ_ADDRESSES=
RABBITMQ_HOST=ec2-mq
RABBITMQ_PORT=5672
RABBITMQ_USER=local_user
RABBITMQ_PASS=local_password
RABBITMQ_VHOST=/

# SMTP configuration (optional until email delivery is enabled)
SMTP_HOST=smtp.example.test
SMTP_PORT=587
SMTP_USER=local_smtp_user
SMTP_PASS=local_smtp_password
SMTP_AUTH=true
SMTP_STARTTLS=true

# Notify runtime
MANAGEMENT_PORT=8081
NOTIFY_MANAGEMENT_PORT=8081
NOTIFY_IDEMPOTENCY_TTL=PT24H
VOUCHER_OUTPUT_DIR=/tmp/notify-vouchers

# Only relevant if an HTTP client needs browser access to health.
CORS_ALLOWED_ORIGINS=
CORS_ALLOWED_METHODS=GET
CORS_ALLOWED_HEADERS=Authorization,Content-Type