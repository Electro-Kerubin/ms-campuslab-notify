# RabbitMQ connection
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=local_user
RABBITMQ_PASS=local_password

# SMTP configuration (optional until email delivery is enabled)
SMTP_HOST=smtp.example.test
SMTP_PORT=587
SMTP_USER=local_smtp_user
SMTP_PASS=local_smtp_password

# Demo de reintentos/DLQ: probabilidad (0.0 a 1.0) de que un mensaje falle. 0 = apagado
NOTIFY_SIMULATED_FAILURE_RATE=0
